    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.3.8"
