# Example environment for `docker compose` (copy to .env and fill in).
# The three STORE_*_SECRET values below are enforced at compose parse time
# (mandatory-variable syntax), so every compose command needs this file with
# them filled in — and ProductionHardeningCheck re-verifies them at store boot.
#
# Generate secrets:  openssl rand -hex 32

# --- Store (application plane, required) -------------------------------------
# ProductionHardeningCheck aborts store startup when these are missing.
STORE_TICKET_SECRET=change-me-openssl-rand-hex-32
STORE_ROLLOUT_SECRET=change-me-openssl-rand-hex-32
STORE_CLI_CLIENT_SECRET=change-me-openssl-rand-hex-32

# The store's PUBLIC address as browsers reach it (through the reverse
# proxy / WAF). Absolute URLs and OAuth redirects derive from it.
#STORE_BASE_URL=https://store.example.com

# --- Monitor (application plane) ---------------------------------------------
# Probe through the proxy/WAF to measure true external reachability; default
# inside the compose network is http://store:8080.
#MONITOR_TARGET_BASE_URL=https://store.example.com
#MONITOR_ALERT_WEBHOOK=

# --- Dependency-plane credentials --------------------------------------------
# Dev defaults below are only safe while ports stay loopback-bound.
#POSTGRES_DB=store
#POSTGRES_USER=store
#POSTGRES_PASSWORD=change-me
#MINIO_ROOT_USER=store
#MINIO_ROOT_PASSWORD=change-me

# --- Publishing (optional) ----------------------------------------------------
# The app ports (8080/8090) publish on all interfaces by default — a WAF on
# another host or LAN clients reach them directly. Set 127.0.0.1 to restrict
# to loopback when the reverse proxy is co-located; to limit an open port to
# the WAF's IP use the DOCKER-USER iptables chain — plain ufw does NOT filter
# Docker-published ports (see DEPLOYMENT.md "WAF on a separate host").
#STORE_BIND_HOST=127.0.0.1
#MONITOR_BIND_HOST=127.0.0.1

# --- Container sizing (all services, optional) -------------------------------
#DOCKER_CPUS_LIMIT=2
#DOCKER_MEM_LIMIT=1g
