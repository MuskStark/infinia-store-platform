{
  "name": "infinia-store-platform",
  "private": true,
  "workspaces": [
    "store-web",
    "monitor-web",
    "ui/*"
  ],
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "web": "yarn workspace @infinia/store-web dev",
    "web:build": "yarn workspace @infinia/store-web build",
    "web:test": "yarn workspace @infinia/store-web test",
    "monitor": "yarn workspace @infinia/monitor-web dev",
    "monitor:build": "yarn workspace @infinia/monitor-web build",
    "monitor:test": "yarn workspace @infinia/monitor-web test",
    "ui:test": "yarn workspace @infinia/magic-ui-vue test",
    "jar": "./build-jar.sh",
    "monitor-jar": "./build-monitor-jar.sh"
  }
}
